<?xml version="1.0" encoding="UTF-8"?>
<!-- Keenu's per-user MSI. In the WiX 3 schema, which both wixl (msitools, on any system) and WiX 3 build:

       wixl -a x64 -D Version=2.0.0 -D ExePath=keenu.exe -D IconPath=keenu.ico -D LicensePath=License.txt \
            -D Publisher="Your Name" -o Keenu.msi packaging/windows/Package.wxs

     The UpgradeCode stays for ever: it is what makes a newer Keenu replace an older one. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Keenu" Language="1033" Version="$(var.Version)"
           Manufacturer="$(var.Publisher)" UpgradeCode="A5E6A55B-8A5C-4B4D-A5C1-6D5E5A7A9C11">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"
             Description="Keenu" Comments="A notch-style desktop island." />
    <Media Id="1" Cabinet="keenu.cab" EmbedCab="yes" />
    <Upgrade Id="A5E6A55B-8A5C-4B4D-A5C1-6D5E5A7A9C11">
      <UpgradeVersion Minimum="$(var.Version)" OnlyDetect="yes" Property="NEWER_INSTALLED" IncludeMinimum="no" />
      <UpgradeVersion Minimum="0.0.1" Maximum="$(var.Version)" Property="OLDER_INSTALLED" IncludeMinimum="yes" IncludeMaximum="no" />
    </Upgrade>
    <Condition Message="A newer version of Keenu is already installed.">NOT NEWER_INSTALLED</Condition>
    <InstallExecuteSequence>
      <RemoveExistingProducts After="InstallInitialize" />
    </InstallExecuteSequence>
    <Icon Id="keenu.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="keenu.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsFolder" Name="Programs">
          <Directory Id="INSTALLFOLDER" Name="Keenu">
            <Component Id="KeenuExecutable" Guid="7C3D0A52-3E7B-4F0C-9B1E-5A6D2E8F1C21">
              <RegistryValue Root="HKCU" Key="Software\Keenu" Name="exe" Type="integer" Value="1" KeyPath="yes" />
              <File Id="KeenuExe" Name="keenu.exe" Source="$(var.ExePath)" />
              <!-- Lets Run and the Start menu find it by name, without changing the user's PATH. -->
              <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\keenu.exe" Value="[INSTALLFOLDER]keenu.exe" Type="string" />
              <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
            </Component>
            <Component Id="KeenuLicense" Guid="D1A4F0B6-2C75-4E18-8E0A-3F9C1B7D2E42">
              <RegistryValue Root="HKCU" Key="Software\Keenu" Name="license" Type="integer" Value="1" KeyPath="yes" />
              <File Id="KeenuLicenseFile" Name="LICENSE.txt" Source="$(var.LicensePath)" />
            </Component>
          </Directory>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Component Id="StartMenuShortcut" Guid="9F2B6C18-7D41-4A3E-B5C0-6E8D1A2F3B63">
          <Shortcut Id="KeenuShortcut" Name="Keenu" Target="[INSTALLFOLDER]keenu.exe" WorkingDirectory="INSTALLFOLDER" Icon="keenu.ico" />
          <RegistryValue Root="HKCU" Key="Software\Keenu" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </Directory>

    <Feature Id="Main" Title="Keenu" Level="1">
      <ComponentRef Id="KeenuExecutable" />
      <ComponentRef Id="KeenuLicense" />
      <ComponentRef Id="StartMenuShortcut" />
    </Feature>
  </Product>
</Wix>
